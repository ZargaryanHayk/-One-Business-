# Create a bot with @BotFather. Keep this file private after copying it to .env.
TELEGRAM_BOT_TOKEN=
APP_ORIGIN=http://localhost:8080
APP_PORT=8080
COOKIE_SECURE=false
POSTGRES_DB=taskbot
POSTGRES_USER=taskbot
POSTGRES_PASSWORD=local-development-change-me
WHISPER_MODEL=small
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Yerevan
